# =============================================================================
# Don't Ghost Me — frontend env
# Copy to .env.local for machine-specific values. Do NOT commit .env.local.
# =============================================================================

# Backend mode:
#   mock  = localStorage demo (default for product UI / Vercel)
#   local = Anvil + DontGhostMe via viem (2–3 member closed loop only)
#   chain = Monad Testnet / public chain via injected wallet (MetaMask / Rabby)
VITE_CHAIN_MODE=mock

# —— Required when VITE_CHAIN_MODE=local ——
# VITE_RPC_URL=/anvil
# VITE_CHAIN_ID=31337
# VITE_CHAIN_NAME=Anvil
# VITE_NATIVE_SYMBOL=ETH
# VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# —— Required when VITE_CHAIN_MODE=chain (Monad Testnet) ——
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_CHAIN_ID=10143
VITE_CHAIN_NAME=Monad Testnet
VITE_NATIVE_SYMBOL=MON
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: speed up first event scan after deploy
# VITE_DEPLOY_FROM_BLOCK=0

# Local mode limits (enforced in UI + createProject):
#   - max 3 members (Anvil demo accounts: Caro / Yunn / Builder 07)
#   - deposit must be > 0
#   - reset clears browser index only — restart Anvil + redeploy to wipe chain

# Deploy to Monad Testnet:
#   1. forge build
#   2. put PRIVATE_KEY in repo-root .env.monad (gitignored)
#   3. fund deployer via https://faucet.monad.xyz
#   4. node frontend/scripts/deploy-monad.mjs
